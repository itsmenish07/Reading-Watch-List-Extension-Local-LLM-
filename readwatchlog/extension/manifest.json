{
  "manifest_version": 3,
  "name": "Reading Tracker AI",
  "version": "1.0",
  "description": "Automatically track and summarize your reading with local AI",
  "permissions": [
    "activeTab",
    "storage",
    "webRequest", "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["transformers-bundle.js", "content.js" , "transformer/transformer.min.js"],
      "run_at" : "document_idle",
      "type": "module"

    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["transformer/transformer.min.js", "transformers-bundle.js", "content.js", "main.js","transformer/models/**/*" , "transformer/models/Xenova/distilbart-cnn-6-6/**"],
      "matches": ["<all_urls>"]
    }
  ]

}