{
  "manifest_version": 3,
  "name": "Reading Tracker AI",
  "version": "1.0",
  "description": "Automatically track and summarize your reading with local AI",
  "permissions": [
    "activeTab",
    "storage",
    "webRequest",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["transformers-bundle.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
  {
    "resources": [
      "firebase-app.js",
      "firebase-firestore.js",
      "main.js",
      "transformer/transformer.min.js"
    ],
    "matches": ["<all_urls>"]
  }
],
"content_security_policy": {
  "extension_pages": "script-src 'self'; object-src 'self';"
}
}